{
  "name": "@fudo/root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "complexity": "cccc --top-cognitive 10 --table apps packages",
    "check:static": "bun run fmt:check && bun run lint && bun run typecheck && bun run complexity",
    "check": "bun run check:static && bun run test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
